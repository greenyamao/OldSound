<ui:FluentWindow x:Class="OldSound.Gui.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Four-Sight 1995"
                  Height="700" Width="980"
                  MinHeight="600" MinWidth="860"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  AllowDrop="True"
                  Drop="Window_Drop"
                  DragOver="Window_DragOver">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0" Title="Four-Sight 1995" Padding="12,6,12,6"/>

        <!-- TOP BAR: PRESET & RESET -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Preset:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox x:Name="ComboPresets" Grid.Column="1" SelectionChanged="ComboPresets_SelectionChanged" VerticalAlignment="Center"/>

                <ui:Button Grid.Column="2" Content="Reset" Click="BtnReset_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DSP SETTINGS -->
            <StackPanel Grid.Column="0">

                <!-- CODEC CARD -->
                <ui:Card Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CODEC" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                        <!-- Type -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboCodec" Grid.Column="1" SelectionChanged="ComboCodec_SelectionChanged">
                                <ComboBoxItem Content="SDX2 (8-Bit Delta)" Tag="sdx2"/>
                                <ComboBoxItem Content="4-Bit (16 Steps)" Tag="adpcm"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- Clock Rate -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtVoiceRate" Text="22 050 Hz" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderVoiceRate" Minimum="11025" Maximum="44100" Value="22050" 
                                    TickFrequency="5512.5" IsSnapToTickEnabled="False" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Aliasing -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Raw Aliasing (Bitcrush):" VerticalAlignment="Center" FontWeight="SemiBold"
                                       ToolTip="Enables harsh raw aliasing without filtering (cheap bitcrusher effect). For authentic 3DO Four-Sight sound this should be OFF (studio FIR anti-aliasing active)."/>
                            <ui:ToggleSwitch x:Name="SwitchAliasing" HorizontalAlignment="Right" IsChecked="False" Click="SwitchAliasing_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- DAC CARD -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="DAC" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                        <!-- Model -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboInterp" Grid.Column="1" SelectionChanged="ComboInterp_SelectionChanged">
                                <ComboBoxItem Content="3DO Linear" Tag="3do"/>
                                <ComboBoxItem Content="Raw Steps" Tag="linear"/>
                                <ComboBoxItem Content="Gaussian" Tag="gauss"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- LPF Cutoff -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="LPF Cutoff:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtFilterCutoff" Text="20 500 Hz" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderFilterCutoff" Minimum="4000" Maximum="22000" Value="20500" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Noise Model & Floor (Master Analog) -->
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Noise:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboNoiseProfile" Grid.Column="1" SelectionChanged="ComboNoiseProfile_SelectionChanged">
                                    <ComboBoxItem Content="Console (SPU)" Tag="console"/>
                                    <ComboBoxItem Content="Cassette (Tape)" Tag="tape"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Noise Floor:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtNoise" Text="Off" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderNoise" Minimum="0" Maximum="1" Value="0" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>

            <!-- RIGHT COLUMN: INPUT & PLAYER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- INPUT CARD -->
                <ui:Card Grid.Row="0" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="INPUT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- Drop area -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" Text="Drop audio file here (MP3, WAV, FLAC)" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtFileMeta" Text="No file loaded" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Render trigger -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatus" Text="Ready" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtStatusDetails" Text="Select file and click Render." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ui:Button x:Name="BtnProcess" Grid.Column="1" Appearance="Primary" Height="36" Padding="24,0" Content="Render" Click="BtnProcess_Click" IsEnabled="False" FontWeight="SemiBold"/>
                        </Grid>

                        <ProgressBar x:Name="ProgressBarStatus" Height="3" Margin="0,10,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:Card>

                <!-- PLAYER CARD (HERO DECK) -->
                <ui:Card Grid.Row="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER: TITLE & A/B SWITCH -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="PLAYER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Right" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbSourceOriginal" Content="Original (A)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="4,0,8,0" IsEnabled="False" FontWeight="SemiBold"/>
                                    <RadioButton x:Name="RbSourceProcessed" Content="Processed (B)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="0,0,4,0" IsEnabled="False" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- CENTER HERO: TRANSPORT & VOLUME -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TRANSPORT BUTTONS & VOLUME ROCKER -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Play & Stop Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnPlay" Appearance="Primary" Height="42" Width="104" Content="Play" Click="BtnPlay_Click" IsEnabled="False" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold"/>
                                    <ui:Button x:Name="BtnStop" Height="42" Width="76" Content="Stop" Click="BtnStop_Click" IsEnabled="False"/>
                                </StackPanel>

                                <!-- Time readout in the middle -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTimeCurrent" Text="00:00" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Text=" / " FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                    <TextBlock x:Name="TxtTimeTotal" Text="00:00" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>

                                <!-- Volume Rocker Slider -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Vol:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderVolume" Width="100" Minimum="0" Maximum="1" Value="0.85" ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtVolume" Text="85%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Width="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- TIMELINE SLIDER -->
                            <Grid Grid.Row="1">
                                <Slider x:Name="SliderTimeline" Minimum="0" Maximum="100" Value="0" 
                                        PreviewMouseDown="SliderTimeline_PreviewMouseDown" 
                                        PreviewMouseUp="SliderTimeline_PreviewMouseUp"
                                        ValueChanged="SliderTimeline_ValueChanged"/>
                            </Grid>
                        </Grid>

                        <!-- BOTTOM BAR: TAG & EXPORT -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Mode tag -->
                            <TextBlock x:Name="TxtStatBar" Text="4-Bit • 18.9k • Clean Digital" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Format:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                                <ComboBox x:Name="ComboExportFormat" Width="145" Margin="0,0,10,0">
                                    <ComboBoxItem Content="MP3 (320 kbps)" Tag="mp3" IsSelected="True"/>
                                    <ComboBoxItem Content="FLAC Lossless" Tag="flac"/>
                                    <ComboBoxItem Content="WAV 16-bit PCM" Tag="wav"/>
                                </ComboBox>
                                <ui:Button x:Name="BtnOpenFolder" Content="Folder" Click="BtnOpenFolder_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                <ui:Button x:Name="BtnSaveAs" Appearance="Primary" Content="Export Audio..." Click="BtnSaveAs_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:Card>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
