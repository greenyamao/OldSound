<Window x:Class="OldSound.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLDSOUND // Retro Console &amp; Tape DSP" 
        Height="820" Width="1120"
        MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Radio Preset Pill Style -->
        <Style x:Key="PresetRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{StaticResource BrushSurfaceElevated}" 
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                                CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dot" Width="8" Height="8" Margin="0,0,10,0" Fill="{StaticResource BrushTextMuted}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderLight}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSurfaceHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}"/>
                                <Setter TargetName="border" Property="Background" Value="#17263A"/>
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource BrushCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR / HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OLDSOUND" FontSize="22" FontWeight="Black" Foreground="{StaticResource BrushCyan}" Margin="0,0,10,0"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="3DO • PS1 • TAPE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushViolet}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Аутентичный DSP-эмулятор звуковых трактов консолей 90-х (Yuji Nomi / Four-Sight, Silent Hill) и компакт-кассеты" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Сбросить настройки" Style="{StaticResource ModernButton}" Click="BtnReset_Click" Margin="0,0,8,0"/>
                <Button Content="Справка" Style="{StaticResource ModernButton}" Click="BtnHelp_Click"/>
            </StackPanel>
        </Grid>

        <!-- MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PRESETS & DSP PARAMETERS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    
                    <!-- PRESETS CARD -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ИСТОРИЧЕСКИЕ ПРОФИЛИ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12"/>
                            
                            <!-- 3DO Four-Sight (1995) -->
                            <RadioButton x:Name="Rb3DoFourSight" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="🌟 3DO Four-Sight (1995) — Юдзи Номи" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="22 кГц SDX2 (Square-Root Delta), linear half_rate.dsp upsampling с зеркальным верхним регистром и ЦАП 20.5 кГц" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- PS1 Four-Sight CD-XA -->
                            <RadioButton x:Name="RbPsxXa" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="💿 PS1 Four-Sight (1996) — CD-XA Level B" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="18.9 кГц 4-bit ADPCM, аппаратный срез 8.5 кГц, ЦАП AK4309 (в обход гауссова фильтра)" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- PS1 Four-Sight SPU VAG -->
                            <RadioButton x:Name="RbPsxSpu" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="🎮 PS1 Four-Sight (1996) — SPU VAG" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="22 кГц ADPCM через память SPU, 4-точечная гауссова интерполяция и 3-полюсный фильтр 10.5 кГц" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- PS1 Silent Hill Fog -->
                            <RadioButton x:Name="RbSilentHill" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="🌫️ PS1 Silent Hill — Акустический туман" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="22 кГц ADPCM, глубокий аналоговый срез 8.5 кГц, бархатный гауссов ЦАП и плотный теплый бас" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- PS1 Lo-Fi 11k -->
                            <RadioButton x:Name="RbPsxLofi" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="🕹️ PS1 Vintage Lo-Fi — 11 кГц сэмплер" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="11.025 кГц 4-bit ADPCM со срезом 5.2 кГц. Зернистый хрустящий звук ранних 32-битных игр" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Cassette Ferric Type I -->
                            <RadioButton x:Name="RbTapeFerric" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="📼 Магнитная кассета Type I (Ferric)" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                    <TextBlock Text="Мягкое магнитное насыщение, подъем баса 65 Гц (+2 dB), детонация Wow/Flutter и тонкий шум ленты" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- PS1 + Tape Hybrid -->
                            <RadioButton x:Name="RbTapeHybrid" Style="{StaticResource PresetRadio}" Checked="PresetRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="⚡ PS1 + Кассета — Ультимативный гибрид" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="22 кГц SPU ADPCM + гауссов ЦАП + аналоговый фильтр 10.5 кГц + сатурация компакт-кассеты" 
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- DSP PARAMETER TWEAKER -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="ПАРАМЕТРЫ ТРАКТА (DSP TWEAKER)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,14"/>

                            <!-- Codec Selector -->
                            <TextBlock Text="Алгоритмический кодек:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbCodec" Background="{StaticResource BrushSurfaceElevated}" Foreground="{StaticResource BrushTextPrimary}" 
                                      BorderBrush="{StaticResource BrushBorder}" Padding="8,6" Margin="0,0,0,12" SelectionChanged="ParamControl_Changed">
                                <ComboBoxItem Content="3DO SDX2 (Square-Root Delta 8-bit)"/>
                                <ComboBoxItem Content="Sony PS1 ADPCM (VAG 4-bit)"/>
                                <ComboBoxItem Content="Bypass (Линейный PCM без потерь)"/>
                            </ComboBox>

                            <!-- Interpolation Selector -->
                            <TextBlock Text="Интерполяция ЦАП:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbInterp" Background="{StaticResource BrushSurfaceElevated}" Foreground="{StaticResource BrushTextPrimary}" 
                                      BorderBrush="{StaticResource BrushBorder}" Padding="8,6" Margin="0,0,0,12" SelectionChanged="ParamControl_Changed">
                                <ComboBoxItem Content="3DO Linear (half_rate.dsp с зеркальными гармониками)"/>
                                <ComboBoxItem Content="Sony 4-Point Gaussian (спад ВЧ от 8 кГц)"/>
                                <ComboBoxItem Content="Standard Linear Resampling"/>
                                <ComboBoxItem Content="Bypass (Без интерполяции)"/>
                            </ComboBox>

                            <!-- Voice Rate Slider -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Частота консольного голоса:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="TxtVoiceRate" Text="22 050 Гц" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderVoiceRate" Style="{StaticResource ModernSlider}" Minimum="11025" Maximum="44100" Value="22050" 
                                    IsSnapToTickEnabled="True" Ticks="11025, 18900, 22050, 32000, 37800, 44100" 
                                    ValueChanged="SliderVoiceRate_ValueChanged" Margin="0,0,0,14"/>

                            <!-- Analog Filter Cutoff Slider -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Срез аналогового фильтра выхода ЦАП:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="TxtFilterCutoff" Text="20 500 Гц" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderFilterCutoff" Style="{StaticResource ModernSlider}" Minimum="4000" Maximum="22000" Value="20500" 
                                    ValueChanged="SliderFilterCutoff_ValueChanged" Margin="0,0,0,6"/>

                            <CheckBox x:Name="ChkAnalogFilter" Content="Включить фильтр выхода ЦАП" IsChecked="True" Foreground="{StaticResource BrushTextSecondary}" 
                                      FontSize="12" Margin="0,0,0,12" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed"/>

                            <!-- SPU Noise Floor & Bus Glue -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Аналоговый фон ЦАП SPU:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="TxtNoiseFloor" Text="-66 dBFS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderNoiseFloor" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" Value="0.3" 
                                    ValueChanged="SliderNoiseFloor_ValueChanged" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Сатурация шины суммирования (Bus Glue):" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="TxtBusGlue" Text="0.35x" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderBusGlue" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" Value="0.35" 
                                    ValueChanged="SliderBusGlue_ValueChanged" Margin="0,0,0,14"/>

                            <!-- Cassette Controls -->
                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,4,0,12" Padding="0,10,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkTape" Content="Включить аналоговую кассету" IsChecked="False" 
                                              Foreground="{StaticResource BrushAmber}" FontWeight="Bold" FontSize="13" 
                                              Margin="0,0,0,10" Checked="ParamControl_Changed" Unchecked="ParamControl_Changed"/>

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Магнитное насыщение (Drive):" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtTapeDrive" Text="1.4x" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderTapeDrive" Style="{StaticResource ModernSlider}" Minimum="0.5" Maximum="2.5" Value="1.4" 
                                            ValueChanged="SliderTapeDrive_ValueChanged" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Детонация (Wow &amp; Flutter):" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtTapeMod" Text="20%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderTapeMod" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="0.2" 
                                            ValueChanged="SliderTapeMod_ValueChanged" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: FILE INPUT, PROCESS ACTION & AUDIO PLAYER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. DRAG & DROP / FILE ZONE -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                    <Grid>
                        <!-- Drop Area -->
                        <Border x:Name="DropAreaBorder" Background="#0E121B" BorderBrush="#2F3B54" BorderThickness="2" 
                                CornerRadius="8" Padding="24" AllowDrop="True" Cursor="Hand" MouseLeftButtonDown="DropArea_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Перетащите аудиофайл сюда" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Поддерживаются MP3, WAV, FLAC, OGG, AIFF" FontSize="12" 
                                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                <Button Content="Выбрать файл на диске..." Style="{StaticResource ModernButton}" 
                                        Click="BtnChooseFile_Click" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Loaded File Info Badge -->
                        <Border x:Name="FileInfoBadge" Background="#162238" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" 
                                CornerRadius="8" Padding="16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" Text="track.mp3" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock x:Name="TxtFileMeta" Text="44 100 Гц • Stereo • 01:50 • 320 kbps" FontSize="12" Foreground="{StaticResource BrushCyan}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Заменить..." Style="{StaticResource ModernButton}" Click="BtnChooseFile_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. PROCESS / RENDER BUTTON & PROGRESS BAR -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                    <StackPanel>
                        <Button x:Name="BtnProcess" Content="⚡ ОБРАБОТАТЬ ТРЕК (RENDER)" Style="{StaticResource PrimaryButton}" 
                                Height="48" Click="BtnProcess_Click" IsEnabled="False"/>
                        
                        <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,12,0,0" Visibility="Collapsed" 
                                     IsIndeterminate="True" Foreground="{StaticResource BrushCyan}"/>
                        
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="TxtStatus" Text="Выберите файл для начала работы" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock x:Name="TxtBench" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushGreen}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. COMPARISON AUDIO PLAYER & EXPORT -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Player Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="СРАВНЕНИЕ ЗВУКА (A/B MONITORING DECK)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="RbPlayProcessed" Content="Обработанный (Ретро)" IsChecked="True" 
                                             Foreground="{StaticResource BrushCyan}" FontWeight="Bold" Margin="0,0,12,0" Checked="AudioSource_Changed"/>
                                <RadioButton x:Name="RbPlayOriginal" Content="Оригинал" 
                                             Foreground="{StaticResource BrushTextSecondary}" Checked="AudioSource_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Player Controls & Waveform placeholder -->
                        <Border Grid.Row="1" Background="#0C0E14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                                CornerRadius="8" Padding="18">
                            <Grid VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Width="480">
                                    
                                    <!-- Play / Pause Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Button x:Name="BtnPlay" Content="▶ Воспроизвести" Style="{StaticResource PrimaryButton}" 
                                                Width="160" Height="40" Click="BtnPlay_Click" IsEnabled="False" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnPause" Content="⏸ Пауза" Style="{StaticResource ModernButton}" 
                                                Width="100" Height="40" Click="BtnPause_Click" IsEnabled="False" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnStop" Content="⏹ Стоп" Style="{StaticResource ModernButton}" 
                                                Width="90" Height="40" Click="BtnStop_Click" IsEnabled="False"/>
                                    </StackPanel>

                                    <!-- Seek Timeline Slider -->
                                    <Slider x:Name="SliderTimeline" Style="{StaticResource ModernSlider}" Value="0" Minimum="0" Maximum="100" 
                                            PreviewMouseDown="SliderTimeline_MouseDown" PreviewMouseUp="SliderTimeline_MouseUp" 
                                            ValueChanged="SliderTimeline_ValueChanged" Margin="0,0,0,8"/>

                                    <Grid>
                                        <TextBlock x:Name="TxtTimeCurrent" Text="00:00" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtNowPlaying" Text="Готов к прослушиванию" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTimeTotal" Text="00:00" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Volume Slider -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <TextBlock Text="Громкость:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderVolume" Style="{StaticResource ModernSlider}" Width="120" Minimum="0" Maximum="1" Value="0.8" 
                                                ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVolume" Text="80%" FontSize="12" Foreground="{StaticResource BrushCyan}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Export Bar -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSaveAs" Content="💾 Сохранить результат как..." Style="{StaticResource ModernButton}" 
                                        Click="BtnSaveAs_Click" IsEnabled="False" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOpenFolder" Content="📂 Открыть папку с файлом" Style="{StaticResource ModernButton}" 
                                        Click="BtnOpenFolder_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="WAV 16-bit / 44.1 kHz • True-Peak Limited" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
