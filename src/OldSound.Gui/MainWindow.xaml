<ui:FluentWindow x:Class="OldSound.Gui.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="OldSound // 1990s Console &amp; Tape DSP"
                  Height="720" Width="1040"
                  MinHeight="640" MinWidth="920"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  AllowDrop="True"
                  Drop="Window_Drop"
                  DragOver="Window_DragOver">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0" Title="OldSound // 1990s Console &amp; Tape DSP" Padding="14,6,14,6"/>

        <!-- TOP BAR: PRESET & PRESET DESCRIPTION -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Preset:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox x:Name="ComboPresets" Grid.Column="1" SelectionChanged="ComboPresets_SelectionChanged" VerticalAlignment="Center"/>

                <ui:Button x:Name="BtnReset" Grid.Column="2" Content="Reset" Click="BtnReset_Click" Margin="10,0,16,0" VerticalAlignment="Center"/>

                <!-- Preset Description / Specs Chip -->
                <TextBlock x:Name="TxtPresetDescription" Grid.Column="3" 
                           Text="1995 3DO Opera sound path (SDX2 Delta Codec, FIR Pre-filter, Sallen-Key LPF)" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DSP SETTINGS -->
            <StackPanel Grid.Column="0">

                <!-- CODEC CARD -->
                <ui:Card Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CODEC" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                        <!-- Type -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="ComboCodec" Grid.Column="1" SelectionChanged="ComboCodec_SelectionChanged">
                                <ComboBoxItem Content="SDX2 (8-Bit Delta)" Tag="sdx2"/>
                                <ComboBoxItem Content="4-Bit (16 Steps)" Tag="adpcm"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- Clock Rate -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtVoiceRate" Text="22 050 Hz" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderVoiceRate" Minimum="11025" Maximum="44100" Value="22050" 
                                    TickFrequency="5512.5" IsSnapToTickEnabled="False" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Aliasing -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Raw Aliasing (Bitcrush):" VerticalAlignment="Center" FontWeight="SemiBold"
                                       ToolTip="Enables harsh raw aliasing without filtering (cheap bitcrusher effect). For authentic 3DO Four-Sight sound this should be OFF (studio FIR anti-aliasing active)."/>
                            <ui:ToggleSwitch x:Name="SwitchAliasing" HorizontalAlignment="Right" IsChecked="False" Click="SwitchAliasing_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- DAC CARD -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="DAC &amp; RECONSTRUCTION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                        <!-- Model -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="ComboInterp" Grid.Column="1" SelectionChanged="ComboInterp_SelectionChanged">
                                <ComboBoxItem Content="3DO Linear" Tag="3do"/>
                                <ComboBoxItem Content="Raw Steps" Tag="linear"/>
                                <ComboBoxItem Content="Gaussian" Tag="gauss"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- LPF Cutoff -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="LPF Cutoff:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtFilterCutoff" Text="20 500 Hz" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderFilterCutoff" Minimum="4000" Maximum="22000" Value="20500" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Noise Model & Floor (Master Analog) -->
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Noise:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ComboNoiseProfile" Grid.Column="1" SelectionChanged="ComboNoiseProfile_SelectionChanged">
                                    <ComboBoxItem Content="Console (SPU)" Tag="console"/>
                                    <ComboBoxItem Content="Cassette (Tape)" Tag="tape"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Noise Floor:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtNoise" Text="Off" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderNoise" Minimum="0" Maximum="1" Value="0" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>

            <!-- RIGHT COLUMN: INPUT & PLAYER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- INPUT CARD -->
                <ui:Card Grid.Row="0" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="INPUT &amp; RENDER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- Drop area -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" Text="Drop audio file here (MP3, WAV, FLAC, OGG, AIFF)" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtFileMeta" Text="No file loaded" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" VerticalAlignment="Center" Height="34" Padding="16,0"/>
                            </Grid>
                        </Border>

                        <!-- Render trigger -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatus" Text="Ready" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="TxtStatusDetails" Text="Select file and click Render." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ui:Button x:Name="BtnProcess" Grid.Column="1" Appearance="Primary" Height="36" Width="120" Content="Render" Click="BtnProcess_Click" IsEnabled="False" FontWeight="SemiBold" FontSize="13"/>
                        </Grid>

                        <ProgressBar x:Name="ProgressBarStatus" Height="3" Margin="0,10,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:Card>

                <!-- PLAYER CARD (HERO DECK) -->
                <ui:Card Grid.Row="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER: TITLE & A/B SWITCH -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="PLAYER &amp; A/B MONITOR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Right" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbSourceOriginal" Content="Original (A)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="4,0,10,0" IsEnabled="False" FontWeight="SemiBold"/>
                                    <RadioButton x:Name="RbSourceProcessed" Content="Processed (B)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="0,0,4,0" IsEnabled="False" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- CENTER HERO: TRANSPORT, CLOCK & VOLUME -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TRANSPORT BUTTONS, DIGITAL CLOCK & VOLUME -->
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Play & Stop Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnPlay" Appearance="Primary" Height="38" Width="96" Content="Play" Click="BtnPlay_Click" IsEnabled="False" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                                    <ui:Button x:Name="BtnStop" Height="38" Width="72" Content="Stop" Click="BtnStop_Click" IsEnabled="False"/>
                                </StackPanel>

                                <!-- Digital Clock Readout -->
                                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#181A1D" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="6" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTimeCurrent" Text="00:00" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                                        <TextBlock Text=" / " FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                        <TextBlock x:Name="TxtTimeTotal" Text="00:00" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                                    </StackPanel>
                                </Border>

                                <!-- Volume Slider -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Vol:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderVolume" Width="95" Minimum="0" Maximum="1" Value="0.85" ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtVolume" Text="85%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Width="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- TIMELINE SLIDER -->
                            <Grid Grid.Row="1">
                                <Slider x:Name="SliderTimeline" Minimum="0" Maximum="100" Value="0" 
                                        PreviewMouseDown="SliderTimeline_PreviewMouseDown" 
                                        PreviewMouseUp="SliderTimeline_PreviewMouseUp" 
                                        ValueChanged="SliderTimeline_ValueChanged"/>
                            </Grid>
                        </Grid>

                        <!-- DSP STATUS BADGE ROW -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,14,0,12">
                            <Grid>
                                <TextBlock x:Name="TxtStatBar" 
                                           Text="SDX2 • 22 050 Hz • 3DO Linear • Studio AA (Clean) • Clean" 
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <!-- DEDICATED EXPORT TOOLBAR ROW -->
                        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Export Format Chooser -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Export Format:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="ComboExportFormat" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="MP3 (320 kbps)" Tag="mp3" IsSelected="True"/>
                                        <ComboBoxItem Content="FLAC Lossless" Tag="flac"/>
                                        <ComboBoxItem Content="WAV 16-bit PCM" Tag="wav"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnOpenFolder" Content="Open Folder" Click="BtnOpenFolder_Click" IsEnabled="False" Margin="0,0,8,0" Height="36" Padding="14,0"/>
                                    <ui:Button x:Name="BtnSaveAs" Appearance="Primary" Content="Export Audio..." Click="BtnSaveAs_Click" IsEnabled="False" FontWeight="SemiBold" Height="36" Padding="18,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </ui:Card>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
