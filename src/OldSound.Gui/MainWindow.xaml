<ui:FluentWindow x:Class="OldSound.Gui.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="OldSound // 1990s Console &amp; Tape DSP"
                  Height="650" Width="980"
                  MinHeight="600" MinWidth="900"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  AllowDrop="True"
                  Drop="Window_Drop"
                  DragOver="Window_DragOver">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0" Title="OldSound // 1990s Console &amp; Tape DSP" Padding="14,6,14,6"/>

        <!-- TOP BAR: PRESET & PROFILE CHIP -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Preset:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <ComboBox x:Name="ComboPresets" Grid.Column="1" SelectionChanged="ComboPresets_SelectionChanged" VerticalAlignment="Center"/>

                <ui:Button x:Name="BtnReset" Grid.Column="2" Content="Reset" Click="BtnReset_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>

                <!-- Compact Profile Chip on the right (with full description in tooltip) -->
                <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PROFILE:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtPresetChip" Text="3DO Opera 1995 (SDX2)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2" Margin="18,14,18,16" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DSP SETTINGS -->
            <StackPanel Grid.Column="0">

                <!-- CODEC CARD -->
                <ui:Card Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CODEC" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Type -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="ComboCodec" Grid.Column="1" SelectionChanged="ComboCodec_SelectionChanged">
                                <ComboBoxItem Content="SDX2 (8-Bit Delta)" Tag="sdx2"/>
                                <ComboBoxItem Content="4-Bit (16 Steps)" Tag="adpcm"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- Clock Rate -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Rate:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtVoiceRate" Text="22 050 Hz" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderVoiceRate" Minimum="11025" Maximum="44100" Value="22050" 
                                    TickFrequency="5512.5" IsSnapToTickEnabled="False" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Aliasing -->
                        <Grid>
                            <TextBlock Text="Raw Aliasing (Bitcrush):" VerticalAlignment="Center" FontWeight="SemiBold"
                                       ToolTip="Enables harsh raw aliasing without filtering (cheap bitcrusher effect). For authentic 3DO Four-Sight sound this should be OFF (studio FIR anti-aliasing active)."/>
                            <ui:ToggleSwitch x:Name="SwitchAliasing" HorizontalAlignment="Right" IsChecked="False" Click="SwitchAliasing_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- DAC CARD -->
                <ui:Card Padding="14">
                    <StackPanel>
                        <TextBlock Text="DAC &amp; RECONSTRUCTION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- Model -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="ComboInterp" Grid.Column="1" SelectionChanged="ComboInterp_SelectionChanged">
                                <ComboBoxItem Content="3DO Linear" Tag="3do"/>
                                <ComboBoxItem Content="Raw Steps" Tag="raw"/>
                                <ComboBoxItem Content="Gaussian" Tag="gauss"/>
                                <ComboBoxItem Content="Linear (Smooth)" Tag="linear"/>
                                <ComboBoxItem Content="Bypass" Tag="bypass"/>
                            </ComboBox>
                        </Grid>

                        <!-- LPF Cutoff -->
                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="LPF Cutoff:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtFilterCutoff" Text="22 000 Hz (Off)" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderFilterCutoff" Minimum="4000" Maximum="22000" Value="22000" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- HF Treble / Air Boost -->
                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="HF Treble / Air:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtTrebleBoost" Text="0 dB" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SliderTrebleBoost" Minimum="-6" Maximum="12" Value="0" SmallChange="0.5" 
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- Noise Model & Controls -->
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Noise:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ComboNoiseProfile" Grid.Column="1" SelectionChanged="ComboNoiseProfile_SelectionChanged">
                                    <ComboBoxItem Content="Cassette (Tape)" Tag="tape"/>
                                    <ComboBoxItem Content="Console (SPU)" Tag="console"/>
                                    <ComboBoxItem Content="Pure Hiss (Flat)" Tag="pure"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Noise Floor:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtNoise" Text="20%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderNoise" Minimum="0" Maximum="1" Value="0.2" 
                                        ValueChanged="Slider_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Noise Tone:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtNoiseTone" Text="Neutral" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderNoiseTone" Minimum="-1" Maximum="1" Value="0" SmallChange="0.1" 
                                        ValueChanged="Slider_ValueChanged"/>
                            </StackPanel>

                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Hum &amp; Rumble:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtNoiseHum" Text="20%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderNoiseHum" Minimum="0" Maximum="1" Value="0.2" SmallChange="0.05" 
                                        ValueChanged="Slider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>

            <!-- RIGHT COLUMN: INPUT & PLAYER (MATCHES LEFT COLUMN HEIGHT) -->
            <StackPanel Grid.Column="2">

                <!-- INPUT & RENDER CARD -->
                <ui:Card Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="INPUT &amp; RENDER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- Drop area -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName" Text="Drop audio file here (MP3, WAV, FLAC, OGG, AIFF)" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtFileMeta" Text="No file loaded" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" VerticalAlignment="Center" Height="32" Padding="14,0"/>
                            </Grid>
                        </Border>

                        <!-- Render trigger -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatus" Text="Ready" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="TxtStatusDetails" Text="Select file and click Render." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <ui:Button x:Name="BtnProcess" Grid.Column="1" Appearance="Primary" Height="34" Width="110" Content="Render" Click="BtnProcess_Click" IsEnabled="False" FontWeight="SemiBold" FontSize="13"/>
                        </Grid>

                        <ProgressBar x:Name="ProgressBarStatus" Height="3" Margin="0,8,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:Card>

                <!-- PLAYER CARD (HERO DECK) -->
                <ui:Card Padding="14">
                    <StackPanel>

                        <!-- HEADER: TITLE & A/B SWITCH -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="PLAYER &amp; A/B MONITOR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Right" Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbSourceOriginal" Content="Original (A)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="4,0,8,0" IsEnabled="False" FontWeight="SemiBold" FontSize="12"/>
                                    <RadioButton x:Name="RbSourceProcessed" Content="Processed (B)" GroupName="DeckSource" Checked="AudioSource_Changed" Margin="0,0,4,0" IsEnabled="False" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TRANSPORT BUTTONS, DIGITAL CLOCK & VOLUME -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Play & Stop Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnPlay" Appearance="Primary" Height="34" Width="84" Content="Play" Click="BtnPlay_Click" IsEnabled="False" Margin="0,0,6,0" FontSize="13" FontWeight="SemiBold"/>
                                <ui:Button x:Name="BtnStop" Height="34" Width="64" Content="Stop" Click="BtnStop_Click" IsEnabled="False"/>
                            </StackPanel>

                            <!-- Digital Clock Readout -->
                            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#181A1D" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" CornerRadius="6" Padding="12,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTimeCurrent" Text="00:00" FontSize="16" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                                    <TextBlock Text=" / " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <TextBlock x:Name="TxtTimeTotal" Text="00:00" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <!-- Volume Slider -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Vol:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderVolume" Width="90" Minimum="0" Maximum="1" Value="0.85" ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtVolume" Text="85%" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0" Width="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- TIMELINE SLIDER -->
                        <Slider x:Name="SliderTimeline" Minimum="0" Maximum="100" Value="0" 
                                Margin="0,0,0,10"
                                PreviewMouseDown="SliderTimeline_PreviewMouseDown" 
                                PreviewMouseUp="SliderTimeline_PreviewMouseUp" 
                                ValueChanged="SliderTimeline_ValueChanged"/>

                        <!-- DSP STATUS BADGE ROW -->
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtStatBar" 
                                       Text="SDX2 • 22 050 Hz • 3DO Linear • Studio AA (Clean) • Clean" 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- DEDICATED EXPORT TOOLBAR ROW -->
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Export Format Chooser -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Export Format:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ComboExportFormat" Width="140" Height="32" VerticalAlignment="Center">
                                        <ComboBoxItem Content="MP3 (320 kbps)" Tag="mp3" IsSelected="True"/>
                                        <ComboBoxItem Content="FLAC Lossless" Tag="flac"/>
                                        <ComboBoxItem Content="WAV 16-bit PCM" Tag="wav"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnOpenFolder" Content="Open Folder" Click="BtnOpenFolder_Click" IsEnabled="False" Margin="0,0,8,0" Height="32" Padding="12,0" FontSize="12"/>
                                    <ui:Button x:Name="BtnSaveAs" Appearance="Primary" Content="Export Audio..." Click="BtnSaveAs_Click" IsEnabled="False" FontWeight="SemiBold" Height="32" Padding="16,0" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
